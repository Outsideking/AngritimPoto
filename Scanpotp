
from PIL import Image, ImageDraw, ImageFont
import cv2
import pytesseract
import numpy as np

---------- CONFIG ----------

canvas_width = 800
canvas_height = 400
background_color = (255, 255, 255)
text_color = (0, 0, 0)
box_color = (255, 0, 0)  # สีกรอบ
font_size = 20
font_path = None  # ใช้ default font

---------- FUNCTIONS ----------

def scan_function(input_data):
features = []
for i, line in enumerate(input_data):
features.append({
"text": line,
"position": (10, i * (font_size + 10))
})
return features

def draw_function(features, canvas, offset=(0,0)):
draw = ImageDraw.Draw(canvas)
font = ImageFont.load_default() if not font_path else ImageFont.truetype(font_path, font_size)
max_x, max_y = 0, 0
for feature in features:
x, y = feature["position"]
draw.text((x + offset[0], y + offset[1]), feature["text"], fill=text_color, font=font)
# คำนวณขนาดของกรอบ
text_width, text_height = draw.textsize(feature["text"], font=font)
max_x = max(max_x, x + offset[0] + text_width)
max_y = max(max_y, y + offset[1] + text_height)
# วาด bounding box รอบ features
draw.rectangle([offset[0], offset[1], max_x + 5, max_y + 5], outline=box_color, width=2)
return (offset[0], offset[1], max_x + 5, max_y + 5)  # คืนค่า bounding box

def postprocess_image(canvas):
return canvas

def scan_image_for_text(image_path, bounding_boxes):
"""
OCR แยกส่วนตาม bounding box
"""
img = cv2.imread(image_path)
gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
results = {}
for idx, box in enumerate(bounding_boxes):
x1, y1, x2, y2 = box
roi = gray[y1:y2, x1:x2]
text = pytesseract.image_to_string(roi)
results[f'part{idx+1}'] = text.strip()
return results

